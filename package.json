{
  "name": "employee-management",
  "version": "2.0.0",
  "description": "MERN _ Employee Management _ Gaurav Kesharwani",
  "author": "Gaurav Kesharwani",
  "scripts": {
    "setup": "node backend/scripts/setup-db.js",
    "migrate:google": "node backend/scripts/migrate-google.js",
    "seed": "node backend/scripts/seed.js",
    "test:mail": "node backend/scripts/test-mail.js",
    "build:admin": "npm run build --prefix admin",
    "build:frontend": "npm run build --prefix frontend",
    "build:ui": "npm run build:admin && npm run build:frontend",
    "admin-api": "node backend/admin-server/server.js",
    "employee-api": "node backend/employee-server/server.js",
    "start": "npm run build:ui && concurrently \"npm run admin-api\" \"npm run employee-api\"",
    "dev:admin": "npm run dev --prefix admin",
    "dev:frontend": "npm run dev --prefix frontend",
    "install-all": "npm install && npm install --prefix admin && npm install --prefix frontend"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "google-auth-library": "^11.3.1",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.12.0",
    "nodemailer": "^10.2.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  }
}
